<div class="autoscroll">
<table class="list odd-even organizations all-organizations">
<thead>
  <tr>
    <% @query.inline_columns.each do |column| %>
      <%= column_header(@query, column) %>
    <% end %>
    <th></th>
  </tr>
</thead>
<tbody>
<% ancestors = [] %>
<% grouped_query_results(organizations, @query) do |organization, group_name, group_count, group_totals| -%>
  <% if group_name %>
    <% reset_cycle %>
    <tr class="group open">
      <td colspan="<%= @query.inline_columns.size + 1 %>">
        <span class="expander" onclick="toggleRowGroup(this);"><%= sprite_icon("angle-down") %></span>
        <span class="name"><%= group_name %></span>
        <% if group_count %>
        <span class="count"><%= group_count %></span>
        <% end %>
        <span class="totals"><%= group_totals %></span>
        <%= link_to_function("#{l(:button_collapse_all)}/#{l(:button_expand_all)}",
                             "toggleAllRowGroups(this)", :class => 'toggle-all') %>
      </td>
    </tr>
  <% end %>
  <%
    level = 0
    if @query.tree_order?
      ancestors.pop while ancestors.any? && !organization.is_descendant_of?(ancestors.last)
      level = ancestors.size
      ancestors << organization unless organization.leaf?
    end
  %>
  <tr id="organization-<%= organization.id %>" class="organization <%= cycle("odd", "even") %> <%= "idnt idnt-#{level}" if level > 0 %> <%= "direction" if organization.direction? %>">
    <% @query.inline_columns.each do |column| %>
      <% if column.name == :name %>
        <td class="<%= column.css_classes %>">
          <%= link_to organization.name, organization_path(organization.identifier) %>
          <%= content_tag :span, sprite_icon('roles'), class: "icon", title: t('field_top_department_in_ldap') if organization.top_department_in_ldap %>
        </td>
      <% else %>
        <%= content_tag('td', column_content(column, organization), class: column.css_classes) %>
      <% end %>
    <% end %>
    <td class="buttons">
      <% if User.current.is_admin_or_instance_manager? %>
        <%= link_to sprite_icon('edit', l(:button_update)), edit_organization_path(organization.identifier) %>
        <%= link_to sprite_icon('del', l(:button_delete)), organization_path(organization.identifier),
                    :data => { :confirm => l(:text_are_you_sure) }, :method => :delete %>
      <% end %>
    </td>
  </tr>
<% end -%>
</tbody>
</table>
</div>
