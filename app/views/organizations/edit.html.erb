<div class="contextual">
  <% if User.current.is_admin_or_manage?(@organization) %>
    <%= link_to sprite_icon('add', l(:label_organization_new)), { :controller => 'organizations', :action => 'new', parent_id: @organization.id } %>
    <%= link_to sprite_icon('user', l(:label_sign_up_new_user)), { :controller => 'users', :action => 'new', :back_url => edit_organization_path(@organization) } %>
  <% end %>
</div>

<h2><%= link_to l(:label_organization_plural), organizations_path %> &#187; <%= link_to_organization @organization %></h2>

<%= render_tabs organization_settings_tabs %>
