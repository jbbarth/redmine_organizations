<div class="contextual">
  <% if User.current.is_admin_or_instance_manager? || @managed_organizations.present? %>
    <%= link_to sprite_icon('add', l(:label_organization_new)), { :controller => 'organizations', :action => 'new' } %>
  <% end %>
  <% if Redmine::Plugin.installed?(:redmine_ldap_minequip) %>
    <%= link_to sprite_icon('reload', l(:label_ldap_sync)), { :controller => 'organizations', :action => 'ldap_sync' } %>
  <% end %>
</div>

<% if @managed_organizations.any? %>
  <h2><%= l(:label_managed_organizations) %></h2>
  <table class="list attributes managed-organizations">
    <thead>
    <tr>
      <th class=left style="width:270px"><%= l(:field_name) %></th>
      <th><%= l(:field_description) %></th>
      <th><%= l(:field_team_leaders) %></th>
      <th><%= l(:field_managers) %></th>
      <th></th>
    </tr>
    </thead>
    <tbody>
    <% @managed_organizations.each do |organization| %>
      <tr class="organization <%= organization.direction? ? "direction" : "" %>">
        <td class="name" data-filter-value="<%= organization.fullname %>">
          <%= link_to h(organization.fullname), { :controller => 'organizations', :action => 'show', :id => organization.identifier } %>
        </td>
        <td class="description"><%= h organization.description %></td>
        <td class="team_leaders"><%= h organization.team_leaders.active.sorted.map(&:to_s).join(', ') %></td>
        <td class="managers"><%= h organization.managers.active.sorted.map(&:to_s).join(', ') %></td>
        <td class="buttons">
          <%= link_to sprite_icon('edit', l(:button_update)), { :controller => 'organizations', :action => 'edit', :id => organization.identifier } %>
          <% if organization != User.current.organization %>
            <%= link_to sprite_icon('del', l(:button_delete)), { :controller => 'organizations', :action => 'destroy', :id => organization.identifier },
                        :data => { :confirm => l(:text_are_you_sure) }, :method => :delete %>
          <% end %>
        </td>
      </tr>
    <% end %>
    </tbody>
  </table>
  <br>
<% end %>

<h2><%= @query.new_record? ? l(:label_all_organizations) : @query.name %></h2>
<%= @query.persisted? && @query.description.present? ? content_tag('p', @query.description, class: 'subtitle') : '' %>

<%= form_tag(organizations_path, method: :get, id: 'query_form') do %>
  <%= render partial: 'queries/query_form' %>
<% end %>

<% if @query.valid? %>
  <% if @organizations.empty? %>
    <p class="nodata"><%= l(:label_no_data) %></p>
  <% else %>
    <%= render partial: 'list', locals: { organizations: @organizations } %>
    <span class="pagination"><%= pagination_links_full @organization_pages, @organization_count %></span>
  <% end %>
  <% other_formats_links do |f| %>
    <%= f.link_to_with_query_parameters 'CSV', {}, :onclick => "showModal('csv-export-options', '350px'); return false;" %>
  <% end %>

  <div id="csv-export-options" style="display:none;">
    <h3 class="title"><%= l(:label_export_options, :export_format => 'CSV') %></h3>
    <%= form_tag(organizations_path(format: 'csv'), method: :get, id: 'csv-export-form') do %>
      <%= query_as_hidden_field_tags(@query) %>
      <%= hidden_field_tag('query_name', @query.name) %>
      <p>
        <label><%= radio_button_tag 'c[]', '', true %> <%= l(:description_selected_columns) %></label><br />
        <label><%= radio_button_tag 'c[]', 'all_inline' %> <%= l(:description_all_columns) %></label>
      </p>
      <%= export_csv_encoding_select_tag %>
      <%= export_csv_separator_select_tag %>
      <p class="buttons">
        <%= submit_tag l(:button_export), :name => nil, :onclick => "hideModal(this);", :data => { :disable_with => false } %>
        <%= link_to_function l(:button_cancel), "hideModal(this);" %>
      </p>
    <% end %>
  </div>
<% end %>

<% content_for :sidebar do %>
  <%= render_sidebar_queries(OrganizationQuery, nil) %>
<% end %>

<% html_title(l(:label_organization_plural)) %>
